DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

STORE_CORS=http://localhost:5173,https://your-frontend.vercel.app,https://cacaudoceu.com.br
ADMIN_CORS=http://localhost:9000,http://localhost:5173,https://cacaudoceu.com.br
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://cacaudoceu.com.br

JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production

# In dev: http://localhost:5173 — In production: https://cacaudoceu.com.br
STORE_URL=http://localhost:5173

# Resend (resend.com) — domain must be verified in Resend dashboard
RESEND_API_KEY=re_...
RESEND_FROM=Cacau do Céu <noreply@jobs.cacaudoceu.com.br>
ADMIN_REPORT_EMAIL=you@email.com

# Stripe — use sk_test_... in dev, sk_live_... in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Melhor Envio — set SANDBOX=true in dev, false in production
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true

# Omie ERP — app_key/app_secret from app.omie.com.br (Configurações > API).
# When set, every paid order is pushed to Omie (customer + sales order) and
# Omie stock overwrites Medusa inventory every 10 min (SKU = código do produto).
OMIE_APP_KEY=
OMIE_APP_SECRET=
# Sales-order fields required by your Omie account — run
#   npx medusa exec ./src/scripts/omie-list-config.ts
# to list the available codes once the keys above are set:
OMIE_CODIGO_CATEGORIA=          # categoria de receita, e.g. 1.01.02 (Vendas)
OMIE_CODIGO_CONTA_CORRENTE=     # id numérico da conta corrente (nCodCC)
# Optional overrides (defaults shown):
# OMIE_ETAPA=10                 # etapa do pedido de venda ao entrar no Omie
# OMIE_CODIGO_PARCELA=000       # 000 = à vista (site já recebeu via Stripe)
# OMIE_FRETE_MODALIDADE=0       # modFrete NF-e: 0 = CIF (emitente contrata)
# OMIE_CODIGO_LOCAL_ESTOQUE=0   # local de estoque no Omie (0 = padrão)
# OMIE_STOCK_LOCATION_ID=       # stock location do Medusa (default: o primeiro)

# Product images — S3-compatible object storage behind a CDN (leave unset to
# keep Medusa's local file storage in dev). For Supabase Storage: create a
# PUBLIC bucket (e.g. "products"), then Project Settings > Storage > S3 keys.
S3_BUCKET=products
S3_ENDPOINT=https://ugzgknhfmunqshginlpf.storage.supabase.co/storage/v1/s3
S3_FILE_URL=https://ugzgknhfmunqshginlpf.supabase.co/storage/v1/object/public/products
S3_REGION=us-west-1             # confirm next to the S3 keys in the dashboard
# Generate at Supabase > Project Settings > Storage > "New access key".
# Real values go in .env / Railway ONLY — never in this committed file:
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
